# SDIO0, partition 1 (FAT32). image.ub contains the kernel, DTB and initrd.
# Keep FIT and relocated initrd below the reserved DDR area at 0x18000000.
setenv fdt_high 0x18000000
setenv initrd_high 0x18000000

if mmc dev 0 && mmc rescan && fatload mmc 0:1 0x10000000 image.ub; then
	bootm 0x10000000
fi

echo "SD boot failed: check mmc 0:1 and image.ub"
