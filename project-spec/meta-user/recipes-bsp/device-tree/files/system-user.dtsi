/include/ "system-conf.dtsi"

/* GEM0 uses the PS MIO RGMII and MDIO pins configured in the XSA.
 * The Linux 5.4 macb driver scans MDIO when no phy-handle is specified,
 * allowing the RTL8211F strap-selected PHY address to be discovered.
 */
&gem0 {
	status = "okay";
	/* RTL8211F RX clock delay must be enabled by its RXDLY strap. */
	phy-mode = "rgmii-id";
};

&can0 {
	status = "okay";
};

/* USB3320 RESEB is active low and connected to PS MIO46. */
&gpio0 {
	usb3320-reset-hog {
		gpio-hog;
		gpios = <46 0>;
		output-high;
		line-name = "usb3320-reseb";
	};
};

&usb0 {
	status = "okay";
	dr_mode = "host";
	usb-phy = <&usb3320_phy>;
};

/ {
	usb3320_phy: phy@e0002000 {
		compatible = "ulpi-phy";
		#phy-cells = <0>;
		reg = <0xe0002000 0x1000>;
		view-port = <0x0170>;
		drv-vbus;
	};

	aliases {
		ethernet0 = &gem0;
	};

	/* Reserve the top 128 MiB of the 512 MiB DDR for shared memory. */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		shared_memory: shared-memory@18000000 {
			reg = <0x18000000 0x08000000>;
			no-map;
		};
	};

	/* The PL clock wizard continuously drives the OV2640 XVCLK at 24 MHz. */
	ov2640_xclk: ov2640-xclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "ov2640_xvclk";
	};

	/* This merges with the generated amba_pl node when pl.dtsi is present. */
	amba_pl {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		serial@43c00000 {
			compatible = "xlnx,xps-uart16550-2.00.a", "ns16550a";
			reg = <0x43c00000 0x10000>;
			reg-offset = <0x1000>;
			reg-shift = <2>;
			/* Let 8250_of keep PS FCLK0 enabled and read its actual rate. */
			/delete-property/ clock-frequency;
			clocks = <&clkc 15>;
			clock-names = "ref_clk";
			interrupt-parent = <&intc>;
			interrupts = <0 29 4>;
			status = "okay";
		};

		/* S2MM channel 1 captures the DVP stream into DDR for V4L2. */
		ov2640_vipp: ov2640-vipp {
			compatible = "xlnx,video";
			dmas = <&axi_vdma_0 1>;
			dma-names = "port0";

			/* The fixed-function PL unpack/AXI-stream blocks are not
			 * separately programmable V4L2 subdevices. */
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					direction = "input";
					ov2640_vcap_in: endpoint {
						remote-endpoint = <&ov2640_out>;
					};
				};
			};
		};
	};
};

/* PL display pipeline: VDMA -> PL display/CRTC -> SII9022 HDMI bridge. */
&axi_dynclk_0 {
	compatible = "digilent,axi-dynclk";
	#clock-cells = <0>;
	clocks = <&clkc 15>;
	clock-output-names = "hdmi_pixel_clk";
	status = "okay";
};

&v_tc_0 {
	/* The PL DRM bridge driver supports the VTC 6.1 programming model. */
	compatible = "xlnx,bridge-v-tc-6.1", "xlnx,v-tc-6.2";
	xlnx,pixels-per-clock = <1>;
	clocks = <&clkc 15>, <&axi_dynclk_0>;
	clock-names = "s_axi_aclk", "clk";
	status = "okay";
};

&i2c1 {
	status = "okay";

	sii9022: hdmi-bridge@39 {
		compatible = "sil,sii9022";
		reg = <0x39>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				sii9022_in: endpoint {
					remote-endpoint = <&hdmi_output_out>;
				};
			};
		};
	};
};

/* PS I2C0 is exported from PL as OV2640_SCCB on N17/P18. */
&i2c0 {
	status = "okay";

	ov2640: camera@30 {
		compatible = "ovti,ov2640";
		reg = <0x30>;
		clocks = <&ov2640_xclk>;
		clock-names = "xvclk";

		port {
			ov2640_out: endpoint {
				remote-endpoint = <&ov2640_vcap_in>;
				bus-type = <5>; /* Parallel DVP */
				bus-width = <8>;
				pclk-sample = <1>;
				hsync-active = <1>;
				vsync-active = <1>;
			};
		};
	};
};

/ {
	amba_pl {
		hdmi_pl_disp: hdmi-pl-disp {
			compatible = "xlnx,pl-disp";
			dmas = <&axi_vdma_0 0>;
			dma-names = "dma0";
			/* AXI VDMA reads RGB565 frames; PL converts to RGB888 for HDMI. */
			xlnx,vformat = "RG16";
			xlnx,bridge = <&v_tc_0>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					hdmi_pl_out: endpoint {
						remote-endpoint = <&hdmi_output_in>;
					};
				};
			};
		};

		/* Connector component joins Xilinx DRM to the standard SII9022 bridge. */
		hdmi_output: hdmi-output {
			compatible = "xlnx,drm-hdmi-output";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					hdmi_output_in: endpoint {
						remote-endpoint = <&hdmi_pl_out>;
					};
				};
				port@1 {
					reg = <1>;
					hdmi_output_out: endpoint {
						remote-endpoint = <&sii9022_in>;
					};
				};
			};
		};
	};
};
