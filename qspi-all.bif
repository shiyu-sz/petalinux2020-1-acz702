the_ROM_image:
{
    [bootloader] images/linux/zynq_fsbl.elf
    // FSBL configures the PL before starting U-Boot. system.bit must be
    // generated with BITSTREAM.GENERAL.COMPRESS=TRUE to fit 16 MiB QSPI.
    images/linux/system.bit
    images/linux/u-boot.elf
    [load=0x00100000] images/linux/system.dtb
    // The FSBL, bitstream, U-Boot and DTB occupy through 0x283100.
    // Keep U-Boot-loaded payloads beyond those sections.
    [partition_owner=uboot, offset=0x00290000] images/linux/boot.scr
    [partition_owner=uboot, offset=0x002A0000] images/linux/image.ub
}
